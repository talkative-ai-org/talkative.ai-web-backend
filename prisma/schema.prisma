// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VaultLocker {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Relationship: A locker can contain many vault keys
  vaults Vault[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("vault_locker")
}

model Vault {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  version     Int         @default(1)
  lockerId    String
  locker      VaultLocker @relation(fields: [lockerId], references: [id])
  
  // Relationship: A vault key can be used by many models
  models      Model[]
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([name])
  @@map("vault")
}

model Model {
  id            String   @id @default(uuid())
  provider      String   // LLMProvider | STTProvider | TTSProvider
  modelName     String   @map("model_name")
  modelType     String   @map("model_type") // "llm" | "stt" | "tts"
  vaultKeyId    String?  @map("vault_key_id")
  configuration Json     // Custom config: { api_url, custom_params, etc. }
  version       Int      @default(1)
  
  // Relationship: A model can optionally reference a vault key
  vaultKey      Vault?   @relation(fields: [vaultKeyId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([provider, modelName, modelType], name: "unique_model_config")
  @@index([modelType])
  @@index([provider])
  @@map("model")
}
