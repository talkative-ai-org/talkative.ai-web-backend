generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VaultLocker {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Relationship: A locker can contain many vault keys
  vaults Vault[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("vault_locker")
}

model Vault {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  version     Int         @default(1)
  lockerId    String
  locker      VaultLocker @relation(fields: [lockerId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([name])
  @@map("vault")
}
